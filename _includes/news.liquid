{% assign news = site.news | reverse %}
{% assign news_size = site.news | size %}
{% assign news_limit = news_size %}
{% assign news_toggle = false %}
{% if include.limit and site.announcements.limit %}
  {% assign news_limit = site.announcements.limit %}
  {% if include.toggle and news_size > news_limit %}
    {% assign news_toggle = true %}
  {% endif %}
{% endif %}
{% if news_toggle %}
  {% assign news_render_limit = news_size %}
{% else %}
  {% assign news_render_limit = news_limit %}
{% endif %}

<div
  class="news"
  {% if news_toggle %}
    data-news-block data-news-limit="{{ news_limit }}"
  {% endif %}
>
  {% if site.news != blank %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 and news_toggle == false %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_render_limit %}
          <tr
            data-news-item
            class="news-item{% if news_toggle and forloop.index > news_limit %} is-collapsed{% endif %}"
          >
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_toggle %}
      <button class="news-toggle" type="button" data-news-toggle aria-expanded="false">Show all news</button>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('[data-news-block]').forEach((block) => {
            const button = block.querySelector('[data-news-toggle]');
            if (!button) return;
            const rows = block.querySelectorAll('[data-news-item]');
            const limit = Number(block.getAttribute('data-news-limit'));
            let expanded = false;
            const sync = () => {
              rows.forEach((row, index) => {
                const shouldHide = !expanded && index >= limit;
                row.classList.toggle('is-collapsed', shouldHide);
              });
              button.textContent = expanded ? 'Show fewer news' : 'Show all news';
              button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            };
            button.addEventListener('click', () => {
              expanded = !expanded;
              sync();
            });
            sync();
          });
        });
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
